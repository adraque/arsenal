        "min": 1,
        "max": 2
      }
    },
    "orbitalOrdnance": {
      "min": 0,
      "max": 1,
      "costEach": 5
    },
    "backupMCV": {
      "min": 0,
      "max": 1,
      "effects": {
        "infantryMax": 8,
        "specialistMax": 3
      }
    }
  },
  "conditionalRules": [
    {
      "id": "encom-extra-ordnance",
      "when": {
        "corporateClient": "encom"
      },
      "set": {
        "construction.orbitalOrdnance.max": 2
      }
    },
    {
      "id": "nile-specialist-cap",
      "when": {
        "corporateClient": "nile"
      },
      "effect": "One chosen specialist type may have a maximum of 3 instead of 2.",
      "implementation": {
        "selector": "specialistType",
        "set": {
          "selectedSpecialistType.max": 3
        }
      }
    },
    {
      "id": "veteran-mcv-loadout",
      "when": {
        "pilotExperience": "veteran"
      },
      "set": {
        "mcvLoadout.primaryWeapons.max": 1,
        "mcvLoadout.equipment.max": 4
      }
    },
    {
      "id": "backup-machete-roster-reduction",
      "when": {
        "backupMCV": "machete"
      },
      "set": {
        "construction.infantry.max": 8,
        "construction.infantry.specialist.max": 3
      }
    }
  ],
  "mcvLoadout": {
    "profile": {
      "min": 1,
      "max": 1,
      "required": true
    },
    "pilotExperience": {
      "min": 1,
      "max": 1,
      "required": true
    },
    "integratedComponent": {
      "min": 1,
      "max": 1,
      "required": true
    },
    "shield": {
      "min": 1,
      "max": 1,
      "required": true
    },
    "sidearm": {
      "min": 1,
      "max": 1,
      "required": true,
      "interpretationNote": "Treated as mandatory because the printed MCV procedure places Sidearm under 'Select Components' and says to choose one. The FAQ says components are mandatory while MCV weapons/equipment are optional."
    },
    "primaryWeapons": {
      "min": 0,
      "max": 2,
      "unique": true,
      "required": false,
      "note": "FAQ makes MCV weapons optional."
    },
    "equipment": {
      "min": 0,
      "max": 3,
      "unique": true,
      "required": false,
      "note": "FAQ makes MCV equipment optional.",
      "eligibleCollections": [
        "mcvEquipment",
        "mcvWeapons where slot == 'equipment'"
      ],
      "countingNote": "The GST places both chassis equipment (Jump Jet, Heat Sink, etc.) and weapon-profile items typed as MCV Equipment (LASR Armament, EM-C Net Launcher, Infrared Array Missile Pod, Mounted LMG) in the same Equipment selection group/category, so all count toward the same effective Equipment cap."
    }
  },
